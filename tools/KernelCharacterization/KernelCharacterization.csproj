<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SqueakyKernelCharacterization</AssemblyName>
    <RootNamespace>SqueakyRatkin.KernelCharacterization</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+kernel</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);SQUEAKY_DEV</DefineConstants>
  </PropertyGroup>

  <!-- 纯度门：迁移清单就是 Kernel/*.cs，零根文件链接。
       Kernel 文件一旦引用 Verse/Unity/RimWorld，本工程编译失败 = 纯度违反（决策 §3.2）。 -->
  <ItemGroup>
    <Compile Include="..\..\Source\SqueakyRatkin\Kernel\*.cs" Link="Kernel\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
