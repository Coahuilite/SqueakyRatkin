<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SqueakyKernelCharacterization</AssemblyName>
    <RootNamespace>SqueakyRatkin.KernelCharacterization</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>0.0.0+kernel</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Dev'">
    <DefineConstants>$(DefineConstants);SQUEAKY_DEV</DefineConstants>
  </PropertyGroup>

  <!-- 纯度门：仅链接零 Verse 引用文件（Kernel/ + 领域枚举 + 动作定义 + ActionKey）。
       Kernel 文件一旦引用 Verse/Unity，本工程编译失败 = 纯度违反（决策 §3.2）。 -->
  <ItemGroup>
    <Compile Include="..\..\Source\SqueakyRatkin\Kernel\*.cs" Link="Kernel\%(Filename)%(Extension)" />
    <Compile Include="..\..\Source\SqueakyRatkin\SqueakActionDomain.cs" Link="Linked\SqueakActionDomain.cs" />
    <Compile Include="..\..\Source\SqueakyRatkin\SqueakVoicePackDomain.cs" Link="Linked\SqueakVoicePackDomain.cs" />
    <Compile Include="..\..\Source\SqueakyRatkin\SqueakActionModel.cs" Link="Linked\SqueakActionModel.cs" />
    <Compile Include="..\..\Source\SqueakyRatkin\ActionKey.cs" Link="Linked\ActionKey.cs" />
  </ItemGroup>

</Project>
