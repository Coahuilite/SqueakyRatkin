<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SqueakyRatkin</AssemblyName>
    <RootNamespace>SqueakyRatkin</RootNamespace>
    <Version>0.3.2</Version>
    <VersionPrefix>$(Version)</VersionPrefix>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\1.6\Assemblies</OutputPath>
    <SqueakyBuildFlavor Condition="'$(SqueakyBuildFlavor)' == ''">Dev</SqueakyBuildFlavor>
    <DefineConstants>$(DefineConstants);SQUEAKY_$(SqueakyBuildFlavor.ToUpper())</DefineConstants>
    <DefineConstants Condition="'$(SqueakyBuildFlavor)' == 'Dev'">$(DefineConstants);SQUEAKY_EXPERIMENTAL</DefineConstants>
    <!-- EXP 本地实验构建标识：产品版本仍为 0.3.2（About.xml/AssemblyVersion 基准），构建身份带 -EXP 尾缀。 -->
    <InformationalVersion Condition="'$(SqueakyInformationalVersion)' == ''">$(Version)-EXP</InformationalVersion>
    <InformationalVersion Condition="'$(SqueakyInformationalVersion)' != ''">$(SqueakyInformationalVersion)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    <PackageReference Include="Lib.Harmony" Version="2.4.*" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
